Rollback Simulation
🔹 Jenkins Pipeline — Rollback on Failure
I am replicating how to simulate rollback if deployment fails.

groovy
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Prasanta Pathnex"
    }
    stages {
        stage('Deploy') {
            steps {
                script {
                    try {
                        sh 'echo "Deploying $INSTITUTE_NAME application..."'
                        sh 'exit 1' // simulate failure
                    } catch (Exception e) {
                        echo "Deployment failed. Rolling back $INSTITUTE_NAME application..."
                    }
                }
            }
        }
    }
}
🔹 GitLab CI — Rollback Simulation
I am replicating how to simulate rollback using after_script.

yaml
stages:
  - deploy

variables:
  INSTITUTE_NAME: "Prasanta Pathnex"

deploy:
  stage: deploy
  image: alpine:latest
  script:
    - echo "Deploying $INSTITUTE_NAME application..."
    - exit 1
  after_script:
    - echo "Deployment failed. Rolling back $INSTITUTE_NAME application"
