🔹 Terraform — Variables, Outputs, tfvars
hcl
# variables.tf
variable "instance_type" {
  default = "c6a.12xlarge"
}

# main.tf
resource "aws_instance" "PrasantaPathnexServer" {
  ami           = "ami-0abcd1234abcd1234"
  instance_type = var.instance_type
}

# output
output "prasanta_pathnex_ip" {
  value = aws_instance.PrasantaPathnexServer.public_ip
}
🔹 Kubernetes — Node Affinity
yaml
apiVersion: v1
kind: Pod
metadata:
  name: prasanta-pathnex-affinity
spec:
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: disktype
                operator: In
                values:
                  - ssd
  containers:
    - name: web
      image: nginx
