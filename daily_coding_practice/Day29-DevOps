stages:
  - infrastructure
  - app_deployment
  - monitoring_checks

variables:
  INSTITUTE_NAME: "Prasanta Pathnex"
  TEAM: "DevOps"
  ENV: "prod"
  PROJECT: "Prasanta-Pathnex-Training"

infrastructure:
