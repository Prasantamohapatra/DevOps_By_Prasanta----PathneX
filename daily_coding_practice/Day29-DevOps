1️⃣ Terraform — EC2 + SG + Key Pair + EBS + Output
hcl
resource "aws_instance" "PrasantaPathnexEC2" {
  ami           = "ami-0abcd1234abcd1234"
  instance_type = "c5.xlarge"
  key_name      = aws_key_pair.PrasantaPathnexKey.key_name
  security_groups = [aws_security_group.PrasantaPathnexSG.name]

  tags = {
    Name = "Prasanta-Pathnex-EC2"
  }
}

resource "aws_security_group" "PrasantaPathnexSG" {
  name   = "prasanta-pathnex-sg"
  vpc_id = aws_vpc.PrasantaPathnexVPC.id

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "Prasanta-Pathnex-SG"
  }
}

resource "aws_key_pair" "PrasantaPathnexKey" {
  key_name   = "PrasantaPathnexKey"
  public_key = file("~/.ssh/id_rsa.pub")
}

resource "aws_ebs_volume" "PrasantaPathnexVolume" {
  availability_zone = "us-east-1a"
  size              = 20

  tags = {
    Name = "Prasanta-Pathnex-Volume"
  }
}

resource "aws_volume_attachment" "PrasantaPathnexAttach" {
  device_name = "/dev/sdh"
  volume_id   = aws_ebs_volume.PrasantaPathnexVolume.id
  instance_id = aws_instance.PrasantaPathnexEC2.id
}

output "prasanta_pathnex_ip" {
  value = aws_instance.PrasantaPathnexEC2.public_ip
}
2️⃣ Ansible — Install Nginx + Deploy HTML
yaml
- name: Setup Nginx for Prasanta Pathnex
  hosts: all
  become: yes

  tasks:
    - name: Install Nginx
      yum:
        name: nginx
        state: present

    - name: Deploy HTML page
      copy:
        dest: /usr/share/nginx/html/index.html
        content: "<h1>Welcome to Prasanta Pathnex</h1>"

    - name: Start and enable Nginx
      service:
        name: nginx
        state: started
        enabled: yes
3️⃣ Kubernetes — Deployment with PVC + NodePort
yaml
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: prasanta-pathnex-pvc
spec:
  accessModes:
    - ReadWriteOnce
  resources:
    requests:
      storage: 1Gi

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prasanta-pathnex-deploy
spec:
  replicas: 2
  selector:
    matchLabels:
      app: prasanta-pathnex
  template:
    metadata:
      labels:
        app: prasanta-pathnex
    spec:
      containers:
        - name: app
          image: nginx
          volumeMounts:
            - mountPath: "/usr/share/nginx/html"
              name: html-storage
      volumes:
        - name: html-storage
          persistentVolumeClaim:
            claimName: prasanta-pathnex-pvc

---
apiVersion: v1
kind: Service
metadata:
  name: prasanta-pathnex-nodeport
spec:
  type: NodePort
  selector:
    app: prasanta-pathnex
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30080
