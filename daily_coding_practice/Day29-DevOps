5️⃣ Jenkins Pipeline — Realistic Declarative Pipeline
I am replicating how to combine all tasks into a realistic Jenkins Pipeline.

groovy
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Prasanta Pathnex"
        TEAM = "DevOps"
        ENV = "prod"
        PROJECT = "Prasanta-Pathnex-Training"
    }
    stages {
        stage('Infrastructure') {
            steps {
                sh 'terraform apply -auto-approve'
            }
        }
        stage('App Deployment') {
            steps {
                sh 'ansible-playbook deploy.yml'
                sh 'kubectl apply -f k8s-deployment.yml'
            }
        }
        stage('Monitoring Checks') {
            steps {
                sh './system-checks.sh'
            }
        }
    }
}
