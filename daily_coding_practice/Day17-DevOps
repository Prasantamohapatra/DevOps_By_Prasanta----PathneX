Day 17 — Loops, ALB, Namespace, Top Processes
🔹 Ansible — Create Multiple Users in Loop
yaml
- name: Create multiple Prasanta Pathnex users
  hosts: all
  become: yes

  vars:
    users:
      - dev1
      - dev2
      - dev3

  tasks:
    - name: Create users
      user:
        name: "{{ item }}"
        state: present
      loop: "{{ users }}"
