apiVersion: v1
kind: Service
metadata:
  name: prasanta-pathnex-nodeport
spec:
  type: NodePort
  selector:
    app: prasanta-pathnex
  ports:
    - port: 80
      targetPort: 80
      nodePort: 30080
🔹 Shell Script — Clean Old Logs
bash
#!/bin/bash

find /var/log -type f -mtime +7 -exec rm -f {} \;

echo "Old logs removed."
Jenkins Scripted Pipeline
🔹 Jenkins Scripted Pipeline — Complex Logic
I am replicating how to write scripted pipelines with conditional logic.

groovy
node {
    def envName = "dev"
    env.INSTITUTE_NAME = "Prasanta Pathnex"
    env.TEAM = "DevOps"

    stage('Checkout') {
        git url: 'https://github.com/Pathnex/sample-java-app.git'
    }

    stage('Build') {
        if (envName == "dev") {
            sh 'echo "Building $INSTITUTE_NAME app in dev environment for $TEAM"'
        } else {
            sh 'echo "Skipping build for $envName"'
        }
    }

    stage('Deploy') {
        input message: "Approve deployment for $envName?"
        sh 'echo "Deploying $INSTITUTE_NAME app to $envName for $TEAM team"'
    }
}
