Day 27 — Copy Directory, EBS Volume, NodePort, Log Cleaner
🔹 Ansible — Copy Directory Recursively
yaml
- name: Copy Prasanta Pathnex files
  hosts: all
  become: yes

  tasks:
    - name: Copy directory
      copy:
        src: /opt/prasanta-pathnex/
        dest: /backup/prasanta-pathnex/
        remote_src: yes
🔹 Terraform — EBS Volume + Attachment
hcl
resource "aws_ebs_volume" "PrasantaPathnexVolume" {
  availability_zone = "us-east-1a"
  size              = 20

  tags = {
    Name = "Prasanta-Pathnex-Volume"
  }
}

resource "aws_volume_attachment" "PrasantaPathnexAttach" {
  device_name = "/dev/sdh"
  volume_id   = aws_ebs_volume.PrasantaPathnexVolume.id
  instance_id = aws_instance.PrasantaPathnexEC2.id
}
🔹 Kubernetes — NodePort Service
