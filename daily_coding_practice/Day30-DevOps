Day 30 — SPEED TYPING (LEVEL 3)
🔹 Ansible — Create User with SSH Key
yaml
- name: Create Prasanta Pathnex admin user
  hosts: all
  become: yes

  tasks:
    - name: Create user
      user:
        name: pathnex-admin
        shell: /bin/bash
        state: present

    - name: Add SSH key
      authorized_key:
        user: pathnex-admin
        key: "{{ lookup('file', '~/.ssh/id_rsa.pub') }}"
