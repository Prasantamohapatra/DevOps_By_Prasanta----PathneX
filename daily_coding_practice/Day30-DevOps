kind: Deployment
metadata:
  name: prasanta-pathnex-deploy
spec:
  replicas: 2
  selector:
    matchLabels:
      app: prasanta-pathnex
  template:
    metadata:
      labels:
        app: prasanta-pathnex
    spec:
      containers:
        - name: app
