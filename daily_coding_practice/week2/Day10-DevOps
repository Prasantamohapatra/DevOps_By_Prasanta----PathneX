🔹 Terraform — Route Table + Association
hcl
resource "aws_route_table" "PrasantaPathnexRT" {
  vpc_id = aws_vpc.PathnexVPC.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.PrasantaPathnexIGW.id
  }

  tags = {
    Name = "Prasanta-Pathnex-RouteTable"
  }
}

resource "aws_route_table_association" "PrasantaPathnexRTA" {
  subnet_id      = aws_subnet.PathnexSubnet.id
  route_table_id = aws_route_table.PrasantaPathnexRT.id
}
