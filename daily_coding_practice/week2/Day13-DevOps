🔹 Jenkins Pipeline — Matrix Build
I am replicating how to run the same build on multiple environments.

groovy
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Prasanta Pathnex"
    }
    matrix {
        axes {
            axis {
                name 'JAVA_VERSION'
                values '8', '11', '17'
            }
        }
        stages {
            stage('Build') {
                steps {
                    sh "echo Building with Java $JAVA_VERSION"
                }
            }
        }
    }
}
