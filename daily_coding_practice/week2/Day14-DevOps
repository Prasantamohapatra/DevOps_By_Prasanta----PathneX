hcl
resource "aws_vpc" "PrasantaPathnexVPC" {
  cidr_block = "10.0.0.0/16"
  tags = { Name = "Prasanta-Pathnex-VPC" }
}

resource "aws_subnet" "PrasantaPathnexSubnet" {
  vpc_id     = aws_vpc.PrasantaPathnexVPC.id
  cidr_block = "10.0.1.0/24"
  tags = { Name = "Prasanta-Pathnex-Subnet" }
}

resource "aws_internet_gateway" "PrasantaPathnexIGW" {
  vpc_id = aws_vpc.PrasantaPathnexVPC.id
  tags = { Name = "Prasanta-Pathnex-IGW" }
}

resource "aws_route_table" "PrasantaPathnexRT" {
  vpc_id = aws_vpc.PrasantaPathnexVPC.id
  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.PrasantaPathnexIGW.id
  }
  tags = { Name = "Prasanta-Pathnex-RT" }
}

resource "aws_route_table_association" "PrasantaPathnexRTA" {
  subnet_id      = aws_subnet.PrasantaPathnexSubnet.id
  route_table_id = aws_route_table.PrasantaPathnexRT.id
}

resource "aws_instance" "PrasantaPathnexEC2" {
  ami           = "ami-0abcd1234abcd1234"
  instance_type = "c5.xlarge"
  subnet_id     = aws_subnet.PrasantaPathnexSubnet.id
  tags = { Name = "Prasanta-Pathnex-EC2" }
}
2️⃣ Ansible — Install Nginx & Deploy HTML File
yaml
- name: Setup Nginx for Prasanta Pathnex
  hosts: all
  become: yes

  tasks:
    - name: Install Nginx
      yum:
        name: nginx
        state: present

    - name: Deploy HTML file
      copy:
        dest: /usr/share/nginx/html/index.html
        content: "<h1>Welcome to Prasanta Pathnex Project</h1>"
3️⃣ Kubernetes — Create Deployment + Service
yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: prasanta-pathnex-deploy
spec:
  replicas: 2
  selector:
    matchLabels:
      app: prasanta-pathnex
  template:
    metadata:
      labels:
        app: prasanta-pathnex
    spec:
      containers:
        - name: web
          image: nginx

---
apiVersion: v1
kind: Service
metadata:
  name: prasanta-pathnex-service
spec:
  selector:
    app: prasanta-pathnex
  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
  type: LoadBalancer
