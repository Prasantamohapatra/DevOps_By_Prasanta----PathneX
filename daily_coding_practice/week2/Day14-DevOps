🔹 Jenkins Pipeline — Scheduled Build
I am replicating how to schedule a Jenkins pipeline using cron.

groovy
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Prasanta Pathnex"
    }
    triggers {
        cron('H 2 * * *') // every day at 2 AM
    }
    stages {
        stage('Checkout') {
            steps {
                git url: 'https://github.com/Pathnex/sample-java-app.git'
            }
        }
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
    }
}
