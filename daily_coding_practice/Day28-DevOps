Rollback Strategies
🔹 Jenkins Pipeline — Automatic Rollback
I am replicating how to rollback automatically if deployment fails.

groovy
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Prasanta Pathnex"
        TEAM = "DevOps"
        ENV = "prod"
    }
    stages {
        stage('Deploy') {
            steps {
                script {
                    try {
                        sh 'echo "Deploying $INSTITUTE_NAME app in $ENV for $TEAM"'
                        sh 'exit 1' // simulate failure
                    } catch (Exception e) {
                        echo "Deployment failed. Rolling back $INSTITUTE_NAME app in $ENV"
                    }
                }
            }
        }
    }
}
🔹 GitLab CI — Rollback Strategy
I am replicating how to simulate rollback in GitLab CI with tags.

yaml
stages:
  - deploy

variables:
  INSTITUTE_NAME: "Prasanta Pathnex"
  TEAM: "DevOps"
  ENV: "prod"

deploy:
  stage: deploy
  image: alpine:latest
  script:
    - echo "Deploying $INSTITUTE_NAME app in $ENV for $TEAM"
    - exit 1
  after_script:
    - echo "Deployment failed. Rolling back $INSTITUTE_NAME app in $ENV"
