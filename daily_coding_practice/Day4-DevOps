## terraform _ec2 with key pair (c6i.8xlarge)

provider "aws"{
    region ="us-east-1"
}

resources "aws_key_pair" "pathnexKey"{

    key_name="pathnexkey"
    public_key="ssh-rsa AAAA...."
}

resource "aws_instance" "pathnexEc2"{
    ami ="ami-09876545rfghnjmk"
    instance_type="c6i.8xlarge"
    key_name="aws_key_pair.pathnexkey.key_name"
tags={
    Name="pathnex-Ec2"
}
}

