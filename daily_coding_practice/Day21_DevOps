🔹 Ansible — Install nginx & Enable Service
yaml
- name: Install and start Nginx for Prasanta Pathnex
  hosts: all
  become: yes

  tasks:
    - name: Install Nginx
      yum:
        name: nginx
        state: present

    - name: Start and enable Nginx
      service:
        name: nginx
        state: started
        enabled: yes
