apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: prasanta-pathnex-db
spec:
  serviceName: "prasanta-pathnex"
  replicas: 2
  selector:
    matchLabels:
      app: prasanta-pathnex-db
  template:
    metadata:
      labels:
        app: prasanta-pathnex-db
    spec:
      containers:
        - name: db
          image: mysql
          env:
            - name: MYSQL_ROOT_PASSWORD
              value: "PrasantaPathnex123"
🔹 Shell Script — Check Service Running
bash
#!/bin/bash

SERVICE="sshd"

if systemctl is-active --quiet $SERVICE; then
  echo "$SERVICE is running"
else
  echo "$SERVICE is NOT running"
fi
Artifacts Promotion
🔹 Jenkins Pipeline — Promote Artifacts
I am replicating how to promote build artifacts from dev to staging.

groovy
pipeline {
    agent any
    environment {
        INSTITUTE_NAME = "Prasanta Pathnex"
    }
    stages {
        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }
        stage('Promote') {
            steps {
                input message: "Promote artifacts to staging?"
                sh 'echo "Promoting artifacts for $INSTITUTE_NAME"'
            }
        }
    }
}
🔹 GitLab CI — Artifacts Promotion
I am replicating how to promote artifacts manually using GitLab CI manual job.

yaml
stages:
  - build
  - promote

build:
  stage: build
  image: maven:3.8.1-jdk-17
  script:
    - mvn clean package
  artifacts:
    paths:
      - target/*.jar
    expire_in: 1 week

promote:
  stage: promote
  image: alpine:latest
  script:
    - echo "Promoting artifacts for Prasanta Pathnex"
  when: manual
